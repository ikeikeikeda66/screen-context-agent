<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.screencontext.indexer</string>
  <key>ProgramArguments</key>
  <array>
    <!-- Replace REPO with the absolute path of your checkout. -->
    <string>REPO/.venv/bin/screen-context</string>
    <string>index</string>
    <string>--watch</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <!-- Replace HOME with your home directory; launchd does not expand ~. -->
  <key>StandardOutPath</key>
  <string>HOME/Library/Logs/ScreenContext/indexer.log</string>
  <key>StandardErrorPath</key>
  <string>HOME/Library/Logs/ScreenContext/indexer.log</string>
</dict>
</plist>
